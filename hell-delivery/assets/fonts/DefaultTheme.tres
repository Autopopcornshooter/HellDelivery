[gd_resource type="Theme" load_steps=7 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/Pretendard-Regular.otf" id="1_regular"]
[ext_resource type="FontFile" path="res://assets/fonts/Pretendard-Bold.otf" id="2_bold"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_normal"]
bg_color = Color(0.075, 0.09, 0.1, 0.88)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
content_margin_left = 14.0
content_margin_top = 6.0
content_margin_right = 14.0
content_margin_bottom = 6.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_hover"]
bg_color = Color(0.157, 0.494, 0.522, 0.85)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
content_margin_left = 14.0
content_margin_top = 6.0
content_margin_right = 14.0
content_margin_bottom = 6.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_pressed"]
bg_color = Color(0.098, 0.35, 0.37, 0.95)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
content_margin_left = 14.0
content_margin_top = 5.0
content_margin_right = 14.0
content_margin_bottom = 5.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_focus"]
bg_color = Color(0.075, 0.09, 0.1, 0.88)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.157, 0.494, 0.522, 1.0)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
content_margin_left = 14.0
content_margin_top = 6.0
content_margin_right = 14.0
content_margin_bottom = 6.0

[resource]
default_font = ExtResource("1_regular")
Label/fonts/font = ExtResource("1_regular")
Button/fonts/font = ExtResource("2_bold")
Button/styles/normal = SubResource("StyleBoxFlat_normal")
Button/styles/hover = SubResource("StyleBoxFlat_hover")
Button/styles/pressed = SubResource("StyleBoxFlat_pressed")
Button/styles/focus = SubResource("StyleBoxFlat_focus")
Button/styles/disabled = SubResource("StyleBoxFlat_normal")
